# Python
__pycache__/
*.pyc
*.pyo

# Environment (.env.example files are committed)
.env
.env.local
.env.*.local

# uv / virtualenv (uv.lock IS committed; the venv is not)
.venv/
backend/.venv/

# Node (package-lock.json IS committed)
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Django runtime artifacts
backend/static/
backend/media/
backend/logs/
celerybeat-schedule
celerybeat-schedule-shm
celerybeat-schedule-wal

# Tooling caches
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# i18n compiled catalogs (regenerated by compilemessages)
*django.mo

# Backups & credentials
dumps/
db-backups/
firebase_credentials/
*credentials*.json
*service*account*.json
*.pem
*.key

# OS / editor (only .vscode/ is shared; per-editor dirs stay local)
.DS_Store
.idea/
.zed/

# Patch/tool backup artifacts
*.orig
