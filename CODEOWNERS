# Review ownership (GitHub reads this file from the repo root). Later lines win.
# Replace the placeholders with real teams/users, e.g. @acme/backend @acme/frontend.
#
# The split mirrors the layout: each team owns its directory outright; the pieces that
# compose them (ops/, CI, the API contract) need a reviewer from each side.

*                 @OWNER/backend-team @OWNER/frontend-team

/backend/         @OWNER/backend-team
/frontend/        @OWNER/frontend-team

# The contract: generated by the backend, consumed by the frontend. A PR that changes
# it is a PR both teams should see.
/api/             @OWNER/backend-team @OWNER/frontend-team
/frontend/src/api/schema.d.ts   @OWNER/backend-team @OWNER/frontend-team

/ops/             @OWNER/backend-team @OWNER/frontend-team
/.github/         @OWNER/backend-team @OWNER/frontend-team
