# Copy to .env.local (gitignored). These are DEV-SERVER settings only: nothing here
# reaches the browser bundle except VITE_APP_VERSION, which CI sets at build time.

# Vite dev server port (the nginx dev edge proxies `/` to this port).
VITE_PORT=5173

# Where the dev proxy forwards backend-owned paths (/api/, /admin/, …): the backend
# stack's edge (`make dev up`, APP_PORT in the root .env).
VITE_PROXY_TARGET=http://localhost:8050
