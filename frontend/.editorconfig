# Self-contained: `root = true` stops the lookup here, so editors use these settings for
# everything under frontend/ regardless of what the repository root defines.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
