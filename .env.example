# dev, test, stage, prod  (validated in settings; anything else raises on startup)
ENVIRONMENT=dev

# ------ APP ------
# Docker Compose project name (prefix for containers/volumes/networks). The dev and
# test stacks append -dev / -test automatically. Use a custom NOT COMPOSE_PROJECT_NAME
# so those per-stack suffixes are preserved.
PROJECT_NAME=project-template
APP_PORT=8050

# Images to PULL in prod (ops/compose/docker-compose.prod.yml / `make prod deploy`). CI
# builds and pushes one image per component; the server only pulls. Pin reproducible
# builds with the sha- tag — ops/scripts/deploy.sh rewrites these two lines on deploy:
#   BACKEND_IMAGE=ghcr.io/igorkhaylov/project-template/backend:sha-<full-sha>
#   FRONTEND_IMAGE=ghcr.io/igorkhaylov/project-template/frontend:sha-<full-sha>
# A moving :latest also works but drifts on the next push.
BACKEND_IMAGE=ghcr.io/igorkhaylov/project-template/backend:latest
FRONTEND_IMAGE=ghcr.io/igorkhaylov/project-template/frontend:latest

# ------ FRONTEND (runtime config, rendered into /config.js by the SPA image's nginx) ------
# Base URL the SPA prefixes API calls with. EMPTY = same origin (the default and the
# recommended topology: the edge routes /api/ to the backend, so no CORS is involved).
# Set only when the API is served from another host, e.g. https://api.example.com.
APP_API_BASE_URL=

# ------ DJANGO ------
DJANGO_APP_NAME=ProjectTemplate
# REQUIRED in stage/prod (>= 50 chars). Generate with: openssl rand -hex 64
DJANGO_SECRET_KEY=CHANGE_ME
# Comma-separated. In prod list your real domain(s) only: health probes (/healthz/,
# /readyz/) bypass this check, so neither `localhost` (container healthcheck) nor pod
# IPs (Kubernetes probes) need to be listed.
DJANGO_ALLOWED_HOSTS=localhost
# :5173 is the Vite dev server (make fe-dev); drop it outside local development.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:${APP_PORT},http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:${APP_PORT},http://localhost:5173
# Logging level for the container logs (DEBUG/INFO/WARNING/ERROR).
DJANGO_LOG_LEVEL=INFO

# Used by `createsuperuserauto` in the release step (`make up` / prod) to create the
# first admin. `make init` generates the password — read it from this file.
# The dev stack does not run the entrypoint: use `make dev createsuperuser` there.
# A placeholder value is skipped in dev and FAILS the boot in stage/prod.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME

# ------ GUNICORN ------
# Few workers per container; scale by adding replicas (pods), not processes.
GUNICORN_WORKERS=2
# Worker request timeout in seconds (sync workers; default upstream is 30).
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30


# ------ POSTGRES ------
POSTGRES_DB=project_template
POSTGRES_USER=project_template_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Persistent DB connection TTL in seconds; a reused connection is health-checked at
# the start of every request, so failover is immediate (this is NOT a check interval).
# Set to 0 (one connection per request) if pgbouncer in transaction mode sits in front.
# POSTGRES_CONN_MAX_AGE=600
# Kubernetes / managed Postgres: ONE connection string wins over the POSTGRES_* set above
# (keep the set for Compose, where it also provisions the db container).
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Same idea for Redis — base address WITHOUT a db number (the app appends /0 and /1):
# REDIS_URL=redis://redis:6379


# ------ MINIO (shared LOCAL object storage, provisioned by `make minio`) ------
# Object storage is NOT part of docker-compose. Locally it is a single SHARED MinIO
# container on the host, reused by every project (no per-project MinIO). `make minio`
# (./ops/scripts/ensure_minio.sh) starts it if needed and creates this project's bucket.
#
# Root credentials of that shared MinIO. Keep them as minioadmin/minioadmin to use the
# local shared MinIO. Set them to ANYTHING ELSE to signal "external/managed storage" —
# then `make minio` does nothing and you provision the bucket on your provider instead.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host ports the shared MinIO is published on (API / console).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# This project's bucket + restricted app user (created by `make minio`).
MINIO_BUCKET_NAME=project-template-bucket
MINIO_APP_USER=project-template-app
MINIO_APP_PASSWORD=CHANGE_ME


# ------ DJANGO MINIO (S3 storage backend Django reads) ------
# SERVER-SIDE endpoint: the address the backend container uses for the S3 API (uploads,
# collectstatic, dumps). For the shared LOCAL MinIO use host.docker.internal (the
# container talks to the host-published MinIO). For external/managed MinIO or S3, set
# this to that endpoint.
DJANGO_MINIO_ENDPOINT=http://host.docker.internal:${MINIO_PORT}
# BROWSER-FACING base URL for media/static links: scheme + host + port ONLY. The bucket
# is appended automatically from DJANGO_MINIO_BUCKET_NAME below:
#   http://localhost:9000  ->  http://localhost:9000/<bucket>/media/photo.jpg
# In production this is the PUBLIC address of your storage, usually NOT the same host as
# DJANGO_MINIO_ENDPOINT above.
DJANGO_MINIO_CUSTOM_URL=http://localhost:${MINIO_PORT}
DJANGO_MINIO_BUCKET_NAME=${MINIO_BUCKET_NAME}
DJANGO_MINIO_ACCESS_KEY=${MINIO_APP_USER}
DJANGO_MINIO_SECRET_KEY=${MINIO_APP_PASSWORD}


# ------ DB BACKUP (optional, tiredofit/db-backup — prod only) ------
# Automated DATABASE backups. DISABLED by default. Enable by activating the compose
# profile (uncomment the next line); `make prod deploy` then starts the db-backup
# service. Media is NOT covered here — see docs/backup.md.
# COMPOSE_PROFILES=backup
#
# Schedule + retention in MINUTES (defaults: every 24h, keep 7 days) + compression.
# DB_BACKUP_INTERVAL=1440
# DB_BACKUP_CLEANUP_TIME=10080
# DB_BACKUP_COMPRESSION=ZSTD
#
# Target: FILESYSTEM (default) or S3.
# DB_BACKUP_LOCATION=FILESYSTEM
# DB_BACKUP_FS_PATH=./db-backups            # host path where FILESYSTEM dumps land
#
# For S3 (set DB_BACKUP_LOCATION=S3) — a DEDICATED bucket/prefix, separate from the
# app's DJANGO_MINIO_* media storage:
# DB_BACKUP_S3_BUCKET=my-db-backups
# DB_BACKUP_S3_PATH=db-backups
# DB_BACKUP_S3_REGION=us-east-1
# DB_BACKUP_S3_KEY_ID=CHANGE_ME
# DB_BACKUP_S3_KEY_SECRET=CHANGE_ME
# DB_BACKUP_S3_HOST=https://s3.example.com  # S3-compatible endpoint; blank = AWS S3
#
# Override the pinned image if needed:
# DB_BACKUP_IMAGE=ghcr.io/tiredofit/docker-db-backup:4.1.100
